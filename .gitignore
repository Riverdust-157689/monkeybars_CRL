# Python
.venv/
.uv-cache/
__pycache__/
*.pyc

# Third-party checkouts (re-fetch with the command in docs/M0_M1_报告.md).
# EXCEPTION: jaxgcrl is *vendored* -- its Python sources (~400 KB) are tracked so a
# fresh clone needs no network and no patch step.  Everything else of it (the .git
# clone, the 36 MB of upstream benchmark meshes, docs, notebooks, tests) stays out;
# see third_party/jaxgcrl/PROVENANCE.md.
third_party/*
!third_party/jaxgcrl/
third_party/jaxgcrl/*
!third_party/jaxgcrl/LICENSE
!third_party/jaxgcrl/PROVENANCE.md
!third_party/jaxgcrl/jaxgcrl/
!third_party/jaxgcrl/jaxgcrl/**
third_party/jaxgcrl/jaxgcrl/envs/assets/
third_party/jaxgcrl/jaxgcrl/**/__pycache__/
third_party/jaxgcrl/jaxgcrl.egg-info/
.third_party/

# Upstream Unitree G1 meshes: COMMITTED (see docs/复现环境.md).  They are small
# enough (~35 MB) and fetching them from a flaky link was the single most common
# setup failure; the scene XML/JSON next to them only reference this directory.
# Verify with assets/g1_brachiation/menagerie_assets_hash.txt.

# Reference PDFs (static, 37 MB)
ref papers/

# Run artefacts (checkpoints, progress.csv, renders).  Version the *code* with git
# and pin every run to a commit via the `git_commit` field of args.json / the ckpt
# config, so a result can always be traced back to the exact source tree.
runs/
.scratch/

# Warp kernel cache (regenerated on demand)
.warp-cache/
.venv-warp/
.venv-rl/
